// Hotel data will be accessed only through the authenticated server API.
// Firebase ID tokens are verified by the backend; Firebase client sessions are not used.
// No client-side creates or updates are permitted, so no client validators apply.
// Planned collections: reservations, staff_access, room_state, hotel_tasks,
// payments, activity, and internal transaction locks. Server IAM is separate.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
