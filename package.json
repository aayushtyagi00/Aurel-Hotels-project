{
  "name": "aurel-hotels",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "node node_modules/vite/bin/vite.js --config firebase-client/vite.config.ts --host 127.0.0.1",
    "build": "node scripts/build-worker.mjs",
    "start": "node node_modules/wrangler/bin/wrangler.js dev --local --ip 127.0.0.1 --port 8787 --config wrangler.jsonc",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:api": "node node_modules/wrangler/bin/wrangler.js dev --local --ip 127.0.0.1 --port 8787 --config wrangler.jsonc",
    "build:frontend": "node scripts/build-firebase.mjs",
    "test:hotel": "node --experimental-vm-modules scripts/test-hotel.mjs",
    "test:auth": "node --experimental-vm-modules scripts/test-auth.mjs",
    "test:search": "node --experimental-vm-modules scripts/test-search.mjs",
    "test:security": "node --experimental-vm-modules scripts/test-security.mjs",
    "deploy:api": "node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
