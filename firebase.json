{
  "firestore": {
    "database": "aurel-hotel",
    "edition": "enterprise",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "aurel-hotels",
    "public": "dist-firebase",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/faq",
        "destination": "/about",
        "type": 301
      }
    ]
  },
  "auth": {
    "authorizedDomains": [
      "aurel-hotels.web.app",
      "aurel-hotels.firebaseapp.com",
      "localhost",
      "127.0.0.1"
    ],
    "providers": {
      "emailPassword": true
    }
  }
}
